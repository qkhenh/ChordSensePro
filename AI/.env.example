# ============================================
# ChordSense Pro — AI Environment Variables
# Copy this file to .env and edit as needed
# Env vars OVERRIDE values in configs/*.yaml
# ============================================

# --- Paths ---
DATA_DIR=../DE/data/export/v2
CHECKPOINT_DIR=results/checkpoints
RESULTS_CSV=results/results.csv

# --- Audio ---
# CROP_S=5
# SAMPLE_RATE=24000

# --- Model ---
# MERT_MODEL=m-a-p/MERT-v1-330M
# POOLING=mean
# DETACH_LOGITS=true
# DROPOUT=0.3

# --- Training ---
# EPOCHS=10
# BATCH_SIZE=16
# LR_HEAD=2e-4
# LR_LORA=5e-5
# WEIGHT_DECAY=0.01
# GRAD_CLIP=1.0
# EARLY_STOP_PATIENCE=3
# FP16=true
# SEED=42
# NUM_WORKERS=2
# LOSS_WEIGHTS=0.5,0.5,0.0
# FOCAL_GAMMA=2.0

# --- LoRA ---
# LORA_ENABLED=false
# LORA_R=16
# LORA_ALPHA=32
# LORA_DROPOUT=0.1

# --- Augment ---
# AUGMENT_ENABLED=false
# PITCH_SHIFT_RANGE=-5,6
# GAIN_DB=6.0
# NOISE_PROB=0.5

