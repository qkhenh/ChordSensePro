@startuml activity_diagram
' UML 2.5 activity diagram — Learning Flow: analyze a song, practice it, correct a chord.
' Business-level view (Ambler / Microsoft activity diagram guidelines): three swimlanes
' (fewer than five), one initial node at the top and one activity final node at the bottom
' (every branch merges back before it), decision diamonds without text, every flow leaving
' a decision guarded with a complete, non-overlapping set of guards, each fork paired with a
' join. Technical steps of the analysis are in the sequence diagram.
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam conditionStyle diamond
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #1F2937
}
skinparam swimlane {
  BorderColor #1F2937
  TitleFontStyle bold
}

|Musician|
start
:Choose a song\n(file, link or demo);

|Web Application|
:Check the file type and size;
if () then ([accepted])
  :Send the analysis request;
  |Server|
  :Check the daily quota\nand the source;
  if () then ([accepted])
    :Create the analysis job;
    fork
      |Web Application|
      :Show the analysis progress;
    fork again
      |Server|
      :Analyze the song\n(chords, beats, key);
      if () then ([succeeded])
        :Save the chart\nto the library;
      else ([failed])
        :Refund the analysis;
      endif
    end fork
  else ([refused])
  endif
else ([not accepted])
endif

|Web Application|
if () then ([chart ready])
  :Open the Practice Workspace;
  |Musician|
  while () is ([continue practicing])
    :Play and loop a section;
    if () then ([a chord is wrong])
      :Correct the chord;
      |Web Application|
      :Show the corrected chord;
      if () then ([Free User])
        :Keep the correction\non this device;
      else ([Paid User])
        |Server|
        :Save the correction\nto the account;
      endif
    else ([chords are right])
    endif
    |Musician|
  endwhile ([finished])
else ([no chart])
  |Web Application|
  :Show the reason (file not accepted,\nquota used up with its reset time,\nor analysis failed);
endif
|Musician|
stop
@enduml
