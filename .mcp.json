{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@bytebase/dbhub@latest", "--transport", "stdio"]
    }
  }
}
